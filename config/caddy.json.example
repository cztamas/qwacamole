{
  "admin": {
    "listen": "127.0.0.1:2019"
  },
  "apps": {
    "http": {
      "http_port": 5002,
      "https_port": 8443,
      "servers": {
        "challenge": {
          "listen": [
            "127.0.0.1:5002"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "qwac_demo",
                  "pki": "{STATE}/pki",
                  "public_pki_only": true
                }
              ]
            }
          ]
        },
        "demo": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            "127.0.0.1:8443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "routes": [
            {
              "handle": [
                {
                  "binding": {
                    "chain_files": [
                      "{STATE}/pki/qwac-leaf.pem",
                      "{STATE}/pki/qwac-intermediate.pem",
                      "{STATE}/pki/qwac-root.pem"
                    ],
                    "directory": "{STATE}/bindings",
                    "hostname": "qwac.example.com",
                    "key_file": "{STATE}/pki/qwac-leaf-key.pem",
                    "lifetime": 45000000000
                  },
                  "handler": "qwac_demo",
                  "pki": "{STATE}/pki"
                }
              ],
              "match": [
                {
                  "path": [
                    "/init"
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "binding": {
                    "chain_files": [
                      "{STATE}/pki/qwac-leaf.pem",
                      "{STATE}/pki/qwac-intermediate.pem",
                      "{STATE}/pki/qwac-root.pem"
                    ],
                    "directory": "{STATE}/bindings",
                    "hostname": "qwac.example.com",
                    "key_file": "{STATE}/pki/qwac-leaf-key.pem",
                    "lifetime": 45000000000
                  },
                  "handler": "qwac_demo_binding"
                },
                {
                  "binding": {
                    "chain_files": [
                      "{STATE}/pki/qwac-leaf.pem",
                      "{STATE}/pki/qwac-intermediate.pem",
                      "{STATE}/pki/qwac-root.pem"
                    ],
                    "directory": "{STATE}/bindings",
                    "hostname": "qwac.example.com",
                    "key_file": "{STATE}/pki/qwac-leaf-key.pem",
                    "lifetime": 45000000000
                  },
                  "handler": "qwac_demo",
                  "pki": "{STATE}/pki"
                }
              ],
              "match": [
                {
                  "host": [
                    "qwac.example.com"
                  ]
                }
              ]
            }
          ],
          "tls_connection_policies": [
            {}
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "acme": {
                  "ca": "https://localhost:14000/dir",
                  "challenges": {
                    "http": {
                      "alternate_port": 5002
                    },
                    "tls-alpn": {
                      "disabled": true
                    }
                  },
                  "test_ca": "https://localhost:14000/dir",
                  "trusted_roots_pem_files": [
                    "{STATE}/pki/acme-root.pem"
                  ]
                },
                "binding": {
                  "chain_files": [
                    "{STATE}/pki/qwac-leaf.pem",
                    "{STATE}/pki/qwac-intermediate.pem",
                    "{STATE}/pki/qwac-root.pem"
                  ],
                  "directory": "{STATE}/bindings",
                  "hostname": "qwac.example.com",
                  "key_file": "{STATE}/pki/qwac-leaf-key.pem",
                  "lifetime": 45000000000
                },
                "module": "qwac_demo"
              }
            ],
            "renewal_window_ratio": 0.8,
            "subjects": [
              "qwac.example.com"
            ]
          }
        ],
        "renew_interval": "2s"
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "{STATE}/caddy-storage"
  }
}

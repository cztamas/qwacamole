{
  "name": "qwacamole-website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "npm run sync && node scripts/astro.mjs check && node --test scripts/*.test.mjs",
    "build": "npm run sync && node scripts/astro.mjs build && node scripts/finalize-search.mjs && node scripts/build-identity.mjs && node scripts/check-links.mjs",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "playwright test",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "typescript": "6.0.3",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true,
    "fsevents": false
  }
}
